#pragma code_page(65001)

1 ICON "icon.ico"
2 ICON "tray-paused.ico"
3 ICON "tray-busy.ico"
4 ICON "tray-error.ico"

// Манифест (RT_MANIFEST = 24): без него exe без подписи выглядит для эвристик антивирусов
// подозрительнее — asInvoker явно говорит, что права администратора не нужны.
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 1,0,2,0
PRODUCTVERSION 1,0,2,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041904B0"
    BEGIN
      VALUE "Comments", "Автор — banshee, twitch.tv/banshee_nt"
      VALUE "CompanyName", "denprog5"
      VALUE "FileDescription", "Солонка — счётчик мата для стрима"
      VALUE "InternalName", "solonka"
      VALUE "LegalCopyright", "© 2026 denprog5, MIT"
      VALUE "ProductName", "Солонка"
      VALUE "FileVersion", "1.0.2"
      VALUE "ProductVersion", "1.0.2"
      VALUE "OriginalFilename", "solonka.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x419, 1200
  END
END
